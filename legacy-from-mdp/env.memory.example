# MDP Memory System — 环境配置示例（EP-111 更新）
# 复制此文件为 .env.memory 并按需填写
# .env.memory 已被 .gitignore 忽略，绝不提交到版本控制

# ══════════════════════════════════════════════════════════
# 【主力】阿里云百炼（DashScope）— 推荐，无需本地 GPU
# ══════════════════════════════════════════════════════════
# API Key：在 https://bailian.console.aliyun.com/ 创建
DASHSCOPE_API_KEY=sk-...

# 百炼 API 端点（默认，通常无需修改）
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 推理/蒸馏/路由/质量门模型（默认 qwen-plus）
# 可选：qwen-max（更强）/ qwen-turbo（更快）
# DASHSCOPE_MODEL_REASONING=qwen-plus

# 代码生成辅助模型（默认 qwen-coder-plus）
# 可选：qwen2.5-coder-32b-instruct
# DASHSCOPE_MODEL_CODING=qwen-coder-plus

# 嵌入模型，用于重复记忆检测（默认 text-embedding-v3）
# DASHSCOPE_MODEL_EMBEDDING=text-embedding-v3

# ══════════════════════════════════════════════════════════
# 【降级】本地 Ollama — 百炼不可用时自动切换
# ══════════════════════════════════════════════════════════
# 服务地址（默认 localhost:11434）
# OLLAMA_BASE_URL=http://localhost:11434

# 推理模型（降级）
# OLLAMA_MODEL_REASONING=deepseek-r1:8b

# 代码模型（降级）
# OLLAMA_MODEL_CODING=deepseek-coder-v2:16b

# 嵌入模型（降级，仅在百炼不可用时使用）
# OLLAMA_MODEL_EMBEDDING=nomic-embed-text

# ══════════════════════════════════════════════════════════
# 【最终兜底】Claude（Pending Prompt 模式）
# ══════════════════════════════════════════════════════════
# 不设置时，自动降级为 Pending 模式：
# prompt 写入 docs/memory/_system/pending_claude_prompts/
# 提示在 Cursor 中手动执行后 --resume 继续
# ANTHROPIC_API_KEY=sk-ant-...

# ══════════════════════════════════════════════════════════
# 快速验证命令
# ══════════════════════════════════════════════════════════
# curl -s https://dashscope.aliyuncs.com/compatible-mode/v1/models \
#   -H "Authorization: Bearer $DASHSCOPE_API_KEY" | python3 -m json.tool | head -20
# python3 scripts/mms/cli.py status
