{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MMS Memory File Front-matter Schema",
  "description": "MDP Memory System v2.1 — 记忆文件 YAML front-matter 校验规则",
  "type": "object",
  "required": ["id", "layer", "dimension", "type", "tier", "tags", "source_ep", "created_at", "version"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(MEM-L|MEM-E|MEM-DB|AD|PAT|SKL)-[0-9A-Z][0-9A-Z-]*$",
      "description": "唯一记忆 ID，前缀参见 config.yaml::id_prefixes（MEM-DB 为遗留格式）"
    },
    "layer": {
      "type": "string",
      "enum": ["L1", "L2", "L3", "L4", "L5", "CC",
               "L1_platform", "L2_infrastructure", "L3_domain",
               "L4_application", "L5_interface", "cross_cutting"],
      "description": "所属软件架构层（短格式 L2 或长格式 L2_infrastructure 均可）"
    },
    "dimension": {
      "type": "string",
      "description": "工程维度（D1-D10 或领域模块如 ontology / data_pipeline）"
    },
    "type": {
      "type": "string",
      "enum": ["lesson", "decision", "error", "pattern", "skill"],
      "description": "记忆类型"
    },
    "tier": {
      "type": "string",
      "enum": ["hot", "warm", "cold", "archive"],
      "description": "访问热度层级，由 GC 自动维护"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "description": "检索关键词标签，至少 1 个"
    },
    "source_ep": {
      "type": "string",
      "pattern": "^EP-[0-9]+$",
      "description": "产生此记忆的 EP 编号"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "创建日期 YYYY-MM-DD"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "记忆版本号，每次修改递增，用于并发冲突检测"
    },
    "last_accessed": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "最后访问日期（GC 自动更新）"
    },
    "access_count": {
      "type": "integer",
      "minimum": 0,
      "description": "累计访问次数（GC LFU 计算基础）"
    },
    "related_memories": {
      "type": "array",
      "items": { "type": "string" },
      "description": "强关联的记忆 ID 列表"
    },
    "also_in": {
      "type": "array",
      "items": { "type": "string" },
      "description": "软链接：此记忆同时属于的其他 (layer, dimension)"
    },
    "generalized": {
      "type": "boolean",
      "description": "是否已泛化（可跨项目复用）"
    },
    "module": {
      "type": "string",
      "description": "所属模块（可选，用于细化分类）"
    }
  }
}
